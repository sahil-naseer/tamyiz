# TAMYIZ™ settings. Copy to .env (npm run dev) or .dev.vars (wrangler). Never commit either: the repo is public.
# On Cloudflare: Pages project → Settings → Variables and secrets. Mark passwords and keys as "Secret".

# Storage for e-books (NOT a variable): Pages project → Settings → Bindings → KV namespace, name TAMYIZ_STORE.
# Locally, npm run dev keeps uploads in .local-store/ instead.

# /admin password (ADMIN_PASSWORD also works). At least 12 characters; use a long one. Changing it logs everyone out.
TAMYIZ_ADMIN_PASSWORD=

# Signs the /admin login cookie and the 2FA code. Any long random text (40+ characters), marked Secret.
# Recommended. Adding or changing it logs every admin out once.
ADMIN_SESSION_SECRET=

# Optional /admin 2-step verification (2FA): comma-separated email addresses to receive a 6-digit login OTP via Brevo.
ADMIN_OTP_EMAIL=

# Razorpay. Without keys, checkout is off and buyers are pointed to WhatsApp (unless TAMYIZ_SANDBOX=true).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: secret for signing download links. If empty, RAZORPAY_KEY_SECRET is used.
# Links made earlier with RAZORPAY_KEY_SECRET keep working after you set this. Changing it later breaks links signed with the old value.
DOWNLOAD_SECRET=

# Test-only simulator: "buys" without paying. Local testing only. NEVER set it on Cloudflare.
TAMYIZ_SANDBOX=

# Optional receipt emails (Resend). RECEIPT_FROM must be a sender verified in Resend.
RESEND_API_KEY=
RECEIPT_FROM=

# Receipt emails (Brevo): used first if set. Sender must be verified in Brevo (default tamyiz.co@gmail.com).
BREVO_API_KEY=

# Razorpay webhook: the secret shown when you create the webhook in the Razorpay dashboard.
# Webhook address: https://<your-site>/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Visitor stats on /admin (optional). CF_API_TOKEN needs "Account Analytics: Read" only.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_SITE_TAG=
